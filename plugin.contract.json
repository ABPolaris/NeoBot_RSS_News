          },
          "name": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Name"
          },
          "nickname": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Nickname"
          },
          "url": {
            "anyOf": [
              {
                "maxLength": 2048,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Url"
          },
          "weight": {
            "anyOf": [
              {
                "maximum": 10,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Weight"
          }
        },
        "required": [
          "id"
        ],
        "title": "SubscriptionUpdateInput",
        "type": "object"
      },
      "output_schema": {
        "$defs": {
          "SubscriptionItem": {
            "additionalProperties": false,
            "properties": {
              "article_count": {
                "default": 0,
                "title": "Article Count",
                "type": "integer"
              },
              "created_at": {
                "title": "Created At",
                "type": "integer"
              },
              "id": {
                "title": "Id",
                "type": "integer"
              },
              "name": {
                "title": "Name",
                "type": "string"
              },
              "nickname": {
                "default": "",
                "title": "Nickname",
                "type": "string"
              },
              "pull_at": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Pull At"
              },
              "url": {
                "title": "Url",
                "type": "string"
              },
              "weight": {
                "title": "Weight",
                "type": "integer"
              }
            },
            "required": [
              "id",
              "name",
              "url",
              "weight",
              "created_at"
            ],
            "title": "SubscriptionItem",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "item": {
            "$ref": "#/$defs/SubscriptionItem"
          },
          "url_changed": {
            "title": "Url Changed",
            "type": "boolean"
          },
          "warning": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Warning"
          }
        },
        "required": [
          "item",
          "url_changed"
        ],
        "title": "SubscriptionUpdateOutput",
        "type": "object"
      },
      "permission": "manage",
      "title": "修改订阅"
    },
    {
      "description": "删除订阅，并级联删除其文章缓存。",
      "id": "subscriptions.remove",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "exclusiveMinimum": 0,
            "title": "Id",
            "type": "integer"
          }
        },
        "required": [
          "id"
        ],
        "title": "SubscriptionRemoveInput",
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": false,
        "properties": {
          "removed": {
            "title": "Removed",
            "type": "boolean"
          }
        },
        "required": [
          "removed"
        ],
        "title": "RemovedOutput",
        "type": "object"
      },
      "permission": "manage",
      "title": "删除订阅"
    },
    {
      "description": "查看最近缓存文章，用于确认拉取是否正常。",
      "id": "articles.list",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "limit": {
            "default": 30,
            "maximum": 200,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "title": "ArticleListInput",
        "type": "object"
      },
      "output_schema": {
        "$defs": {
          "ArticleItem": {
            "additionalProperties": false,
            "properties": {
              "guid": {
                "title": "Guid",
                "type": "string"
              },
              "has_body": {
                "title": "Has Body",
                "type": "boolean"
              },
              "link": {
                "title": "Link",
                "type": "string"
              },
              "pubdate": {
                "title": "Pubdate",
                "type": "integer"
              },
              "source_id": {
                "title": "Source Id",
                "type": "integer"
              },
              "source_name": {
                "title": "Source Name",
                "type": "string"
              },
              "title": {
                "title": "Title",
                "type": "string"
              }
            },
            "required": [
              "source_id",
              "source_name",
              "guid",
              "title",
              "link",
              "pubdate",
              "has_body"
            ],
            "title": "ArticleItem",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "items": {
            "items": {
              "$ref": "#/$defs/ArticleItem"
            },
            "title": "Items",
            "type": "array"
          }
        },
        "required": [
          "items"
        ],
        "title": "ArticleListOutput",
        "type": "object"
      },
      "permission": "read",
      "title": "查看缓存文章"
    },
    {
      "description": "查看发送开关、缓存计数与最近拉取时间。",
      "id": "status.get",
