            "title": "Available Weights",
            "type": "array"
          },
          "items": {
            "items": {
              "$ref": "#/$defs/SubscriptionItem"
            },
            "title": "Items",
            "type": "array"
          },
          "max_count": {
            "title": "Max Count",
            "type": "integer"
          },
          "warning": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Warning"
          }
        },
        "required": [
