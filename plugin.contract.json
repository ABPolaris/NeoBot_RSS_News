                "type": "integer"
              },
              "created_at": {
                "title": "Created At",
                "type": "integer"
              },
              "id": {
                "title": "Id",
                "type": "integer"
              },
              "name": {
                "title": "Name",
                "type": "string"
              },
              "pull_at": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Pull At"
              },
              "url": {
                "title": "Url",
                "type": "string"
              },
              "weight": {
                "title": "Weight",
                "type": "integer"
              }
            },
            "required": [
              "id",
              "name",
              "url",
