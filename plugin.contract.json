        "additionalProperties": false,
        "properties": {
          "article_count": {
            "title": "Article Count",
            "type": "integer"
          },
          "cache_days": {
            "title": "Cache Days",
            "type": "integer"
          },
          "content_format": {
            "title": "Content Format",
            "type": "string"
          },
          "latest_pull_at": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Latest Pull At"
          },
          "message_interval_seconds": {
            "title": "Message Interval Seconds",
            "type": "integer"
          },
          "per_destination_limit": {
            "title": "Per Destination Limit",
            "type": "integer"
          },
          "per_source_limit": {
            "title": "Per Source Limit",
            "type": "integer"
          },
          "pull_interval_minutes": {
            "title": "Pull Interval Minutes",
            "type": "integer"
          },
          "send_enabled": {
            "title": "Send Enabled",
            "type": "boolean"
          },
          "server_time": {
            "title": "Server Time",
            "type": "integer"
          },
          "subscription_count": {
            "title": "Subscription Count",
            "type": "integer"
          },
          "supports_send_test": {
            "default": true,
            "title": "Supports Send Test",
            "type": "boolean"
          },
          "warning": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
