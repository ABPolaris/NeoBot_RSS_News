                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Pull At"
              },
              "url": {
                "title": "Url",
                "type": "string"
              },
              "weight": {
                "title": "Weight",
                "type": "integer"
              }
            },
            "required": [
              "id",
              "name",
              "url",
              "weight",
              "created_at"
            ],
            "title": "SubscriptionItem",
            "type": "object"
