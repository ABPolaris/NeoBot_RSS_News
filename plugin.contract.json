    {
      "description": "随机读取一篇缓存文章，按指定格式发送到私聊 QQ。只读数据库与配置，不写入已发送记录，也不修改接收者。",
      "id": "system.send_test",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "content_format": {
            "enum": [
              "title",
              "title_link",
              "title_lead",
              "title_body",
              "title_link_lead"
            ],
            "title": "Content Format",
            "type": "string"
          },
          "qq": {
            "pattern": "^[1-9]\\d{4,12}$",
            "title": "Qq",
            "type": "string"
          },
          "send_format": {
            "enum": [
              "merged",
              "per_source",
              "per_article"
            ],
            "title": "Send Format",
            "type": "string"
          }
        },
        "required": [
          "qq",
          "send_format",
          "content_format"
        ],
        "title": "SendTestInput",
        "type": "object"
      },
      "output_schema": {
        "additionalProperties": false,
        "properties": {
          "destination_id": {
            "title": "Destination Id",
            "type": "integer"
          },
          "message_chars": {
            "title": "Message Chars",
            "type": "integer"
          },
          "pubdate": {
            "title": "Pubdate",
            "type": "integer"
          },
          "sent": {
            "title": "Sent",
            "type": "boolean"
          },
          "source_id": {
            "title": "Source Id",
            "type": "integer"
          },
          "source_name": {
            "title": "Source Name",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "sent",
