{
  "actions": [
    {
      "description": "列出订阅、简称、权重与已缓存文章数。",
      "id": "subscriptions.list",
      "input_schema": null,
      "output_schema": {
        "$defs": {
          "SubscriptionItem": {
            "additionalProperties": false,
            "properties": {
              "article_count": {
                "default": 0,
                "title": "Article Count",
                "type": "integer"
              },
              "created_at": {
                "title": "Created At",
                "type": "integer"
              },
              "id": {
                "title": "Id",
                "type": "integer"
              },
              "name": {
                "title": "Name",
                "type": "string"
              },
              "nickname": {
                "default": "",
                "title": "Nickname",
                "type": "string"
              },
              "pull_at": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Pull At"
              },
              "url": {
                "title": "Url",
                "type": "string"
              },
              "weight": {
                "title": "Weight",
                "type": "integer"
              }
            },
            "required": [
              "id",
              "name",
              "url",
              "weight",
              "created_at"
            ],
            "title": "SubscriptionItem",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "available_weights": {
            "items": {
              "type": "integer"
            },
            "title": "Available Weights",
            "type": "array"
          },
          "items": {
            "items": {
              "$ref": "#/$defs/SubscriptionItem"
            },
            "title": "Items",
            "type": "array"
          },
          "max_count": {
            "title": "Max Count",
            "type": "integer"
          },
          "warning": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Warning"
          }
        },
        "required": [
          "items",
          "max_count",
          "available_weights"
        ],
        "title": "SubscriptionListOutput",
        "type": "object"
      },
      "permission": "read",
      "title": "查看订阅"
    },
    {
      "description": "添加一条 RSS 订阅；最多 7 条，URL 与昵称不能重复。",
      "id": "subscriptions.create",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "nickname": {
            "default": "",
            "maxLength": 64,
            "title": "Nickname",
            "type": "string"
          },
          "url": {
            "maxLength": 2048,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          },
          "weight": {
            "anyOf": [
              {
                "maximum": 10,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Weight"
          }
        },
        "required": [
          "name",
          "url"
        ],
        "title": "SubscriptionCreateInput",
        "type": "object"
      },
      "output_schema": {
        "$defs": {
          "SubscriptionItem": {
            "additionalProperties": false,
            "properties": {
              "article_count": {
                "default": 0,
                "title": "Article Count",
                "type": "integer"
              },
              "created_at": {
                "title": "Created At",
                "type": "integer"
              },
              "id": {
                "title": "Id",
                "type": "integer"
              },
              "name": {
                "title": "Name",
                "type": "string"
              },
              "nickname": {
                "default": "",
                "title": "Nickname",
                "type": "string"
              },
              "pull_at": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Pull At"
              },
              "url": {
                "title": "Url",
                "type": "string"
              },
              "weight": {
                "title": "Weight",
                "type": "integer"
              }
            },
            "required": [
              "id",
              "name",
              "url",
              "weight",
              "created_at"
            ],
            "title": "SubscriptionItem",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "item": {
            "$ref": "#/$defs/SubscriptionItem"
          },
          "warning": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Warning"
          }
        },
        "required": [
          "item"
        ],
        "title": "SubscriptionCreateOutput",
        "type": "object"
      },
      "permission": "manage",
      "title": "添加订阅"
    },
    {
